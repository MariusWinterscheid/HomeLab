# ==========================================
# Nextcloud AIO Environment Configuration
# ==========================================

# Pfad für das Nextcloud Backup-Verzeichnis
# Beispiel: /mnt/backup/nextcloud
NEXTCLOUD_BACKUP_DIR=/dein/pfad/zum/backup

# Pfad für das Nextcloud Daten-Verzeichnis
# Beispiel: /mnt/nas/nextcloud-data
# ACHTUNG: Nach der Erstinstallation nicht mehr ändern!
NEXTCLOUD_DATADIR=/dein/pfad/zu/den/daten